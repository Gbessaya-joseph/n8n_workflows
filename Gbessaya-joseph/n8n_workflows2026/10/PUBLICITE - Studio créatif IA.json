          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"claude-sonnet-4-6\", \"max_tokens\": 800, \"messages\": [ { \"role\": \"user\", \"content\": \"Génère \" + ($json.body.variantCount || 3) + \" variantes publicitaires (slogan + accroche courte) en \" + ($json.body.language || \"français\") + \" pour l'annonce suivante : \" + $json.body.brief + \". Réponds uniquement en JSON sous la forme {\\\"variants\\\": [\\\"...\\\"]}.\" } ] } }}",
        "options": {}
      },
      "id": "2ba05f8e-b2c7-4d85-8a87-4a192df4427e",
      "name": "Appel Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -112,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet variants = [];\ntry {\n  const text = raw.content?.[0]?.text || '{}';\n  const parsed = JSON.parse(text);\n  variants = parsed.variants || [];\n} catch (e) {\n  variants = [];\n}\nreturn [{ json: { jobId: $('Webhook - Réception demande').item.json.body.jobId, contentType: 'texte', variants, rawResponse: raw } }];"
      },
      "id": "be710af7-0fea-43ac-b261-c6177e1dfc31",
      "name": "Formatage variantes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// Stub de modération — à remplacer par une vraie intégration (liste de mots interdits, RGPD/CCPA, cohérence de marque).\nconst bannedWords = ['motinterdit1', 'motinterdit2'];\nconst input = $input.first().json;\nconst rejected = (input.variants || []).some(v => bannedWords.some(w => v.toLowerCase().includes(w)));\nreturn [{\n  json: {\n    ...input,\n    moderation: rejected ? 'rejected' : 'approved',\n    status: rejected ? 'rejected' : 'completed'\n  }\n}];"
      },
